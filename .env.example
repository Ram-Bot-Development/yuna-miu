# Bot token from the Discord Developer Portal. Do not commit the real value.
DISCORD_TOKEN=

# Application id from the same Discord application.
DISCORD_CLIENT_ID=

# Dev only. Commands show up right away in this server.
# Leave blank for global commands (can take up to an hour).
DISCORD_GUILD_ID=

# true = register commands when the bot starts. Docker turns this on.
DEPLOY_COMMANDS=false

# Where an old settings.json is imported from, and where that file is renamed after import.
DATA_DIR=./data

# MariaDB. Leave DB_HOST empty to keep using the settings file.
# Docker Compose starts MariaDB on the internal network only and sets DB_HOST=db for the bot.
# The database port is not published to the host. Set both passwords here before `docker compose up`.
# Do not commit the real values.
DB_HOST=
DB_PORT=3306
DB_USER=yuna
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=yuna

# Web dashboard. It is served by the bot process inside the container. Leave these blank to keep it off.
# Register DASHBOARD_PUBLIC_URL + /auth/callback as a Discord OAuth2 redirect.
# Local: http://127.0.0.1:8787 with `docker compose -f docker-compose.yml -f docker-compose.local.yml up`
# Server: do not publish the port. Attach the npm_default network and proxy to yuna-miu:8787.
# DASHBOARD_SESSION_SECRET is a long random string. A restart asks you to log in again.
DISCORD_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_PUBLIC_URL=
DASHBOARD_PORT=8787

# Privileged intents. Restart after changing them.
# Server Members is required for welcome messages. Leave this off until that intent is enabled in the Developer Portal.
ENABLE_GUILD_MEMBERS_INTENT=false
# Message Content is on so opt-in contextual replies can read channel messages.
# Set this to false only if the privileged intent is turned off in the Developer Portal.
ENABLE_MESSAGE_CONTENT_INTENT=true
