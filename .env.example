# Bot token from the Discord Developer Portal. Do not commit the real value.
DISCORD_TOKEN=

# Application id from the same Discord application.
DISCORD_CLIENT_ID=

# Dev only. Commands show up right away in this server.
# Leave blank for global commands (can take up to an hour).
DISCORD_GUILD_ID=

# true = register commands when the bot starts. Docker turns this on.
DEPLOY_COMMANDS=false

# Where guild settings are stored. Created if it is missing.
DATA_DIR=./data

# Privileged intents. Restart after changing them.
# Server Members is required for welcome messages. Leave this off until that intent is enabled in the Developer Portal.
ENABLE_GUILD_MEMBERS_INTENT=false
# Message Content is on so opt-in contextual replies can read channel messages.
# Set this to false only if the privileged intent is turned off in the Developer Portal.
ENABLE_MESSAGE_CONTENT_INTENT=true

# Optional AI. Leave AI_PROVIDER empty to keep Yuna fully scripted.
# Supported adapters: ram-ai, openai-compatible, local
#
# Ram AI (https://ai.rambot.xyz). Put the key from Settings → API access here.
# Default model is ram-ai-2-fast. Other public ids include ram-ai-7b, ram-ai-2, and ram-ai-1-medium.
# AI_PROVIDER=ram-ai
# RAM_AI_API_KEY=
# AI_MODEL=ram-ai-2-fast
# RAM_AI_BASE_URL=https://ai.rambot.xyz
#
# OpenAI-compatible or a local server:
# AI_PROVIDER=local
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=
# AI_MODEL=
# Optional. Ram AI waits 10 minutes unless this is set. Other providers default to 15 seconds. Maximum is 20 minutes.
# AI_TIMEOUT_MS=
# AI_MAX_OUTPUT_TOKENS=300
# AI_CONTEXT_MESSAGES=6
# AI_USER_PER_MINUTE=5
# AI_GUILD_PER_MINUTE=10
