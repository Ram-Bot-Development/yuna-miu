# Bot token from the Discord Developer Portal. Do not commit the real value.
DISCORD_TOKEN=

# Application id from the same Discord application.
DISCORD_CLIENT_ID=

# Dev only. Commands show up right away in this server.
# Leave blank for global commands (can take up to an hour).
DISCORD_GUILD_ID=

# true = register commands when the bot starts. Docker turns this on.
DEPLOY_COMMANDS=false
